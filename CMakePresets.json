{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Paths come from QT_VERSION_DIR (e.g. C:/Qt/6.12.0), ANDROID_SDK_ROOT and ANDROID_NDK_ROOT. scripts/env.ps1 sets them.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "PATH": "$env{QT_VERSION_DIR}/../Tools/Ninja${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "desktop",
      "displayName": "Desktop (Windows, MinGW)",
      "description": "Native Windows build for fast UI iteration.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "environment": {
        "PATH": "$env{QT_VERSION_DIR}/../Tools/mingw1310_64/bin${pathListSep}$env{QT_VERSION_DIR}/../Tools/Ninja${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_VERSION_DIR}/mingw_64"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (emulator)",
      "inherits": "android-base",
      "toolchainFile": "$env{QT_VERSION_DIR}/android_x86_64/lib/cmake/Qt6/qt.toolchain.cmake"
    },
    {
      "name": "android-arm64-v8a",
      "displayName": "Android arm64-v8a (64-bit phones)",
      "inherits": "android-base",
      "toolchainFile": "$env{QT_VERSION_DIR}/android_arm64_v8a/lib/cmake/Qt6/qt.toolchain.cmake"
    },
    {
      "name": "android-armeabi-v7a",
      "displayName": "Android armeabi-v7a (older 32-bit phones)",
      "inherits": "android-base",
      "toolchainFile": "$env{QT_VERSION_DIR}/android_armv7/lib/cmake/Qt6/qt.toolchain.cmake"
    },
    {
      "name": "core-msvc",
      "displayName": "Core only, MSVC (no Qt)",
      "description": "Builds and tests the Qt-free core with Visual Studio 2022. Needs no Qt install.",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "COOKBOOK_BUILD_APP": "OFF" }
    },
    {
      "name": "core-linux",
      "displayName": "Core only, Linux (no Qt)",
      "description": "Builds and tests the Qt-free core with the system compiler (GCC 13 on Ubuntu 24.04).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "COOKBOOK_BUILD_APP": "OFF", "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "desktop", "configurePreset": "desktop" },
    { "name": "android-x86_64", "configurePreset": "android-x86_64", "targets": [ "apk" ] },
    { "name": "android-arm64-v8a", "configurePreset": "android-arm64-v8a", "targets": [ "apk" ] },
    { "name": "android-armeabi-v7a", "configurePreset": "android-armeabi-v7a", "targets": [ "apk" ] },
    { "name": "core-msvc", "configurePreset": "core-msvc", "configuration": "Debug" },
    { "name": "core-linux", "configurePreset": "core-linux" }
  ],
  "testPresets": [
    { "name": "desktop", "configurePreset": "desktop", "output": { "outputOnFailure": true } },
    { "name": "core-msvc", "configurePreset": "core-msvc", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "core-linux", "configurePreset": "core-linux", "output": { "outputOnFailure": true } }
  ]
}
