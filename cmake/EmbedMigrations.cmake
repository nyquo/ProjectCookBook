# Script mode, run at build time by core/CMakeLists.txt:
#   cmake -DSCHEMA_DIR=<dir> -DOUTPUT=<header> -P EmbedMigrations.cmake
#
# Embeds every <SCHEMA_DIR>/NNN_name.sql file into a C++ header, so the core
# needs no file access at runtime. Files must be numbered 001, 002, ... with no
# gaps; NNN becomes the schema version (PRAGMA user_version) after that file ran.
# The SQL is written as hex bytes: no escaping, no string-literal length limits.

file(GLOB files RELATIVE "${SCHEMA_DIR}" "${SCHEMA_DIR}/*.sql")
list(SORT files)

set(arrays "")
set(entries "")
set(expected 1)
foreach(file IN LISTS files)
    if(NOT file MATCHES "^([0-9][0-9][0-9])_[a-z0-9_]+\\.sql$")
        message(FATAL_ERROR "Migration '${file}' must be named NNN_lowercase_name.sql")
    endif()
    string(REGEX REPLACE "^0+" "" version "${CMAKE_MATCH_1}")
    if(NOT version EQUAL expected)
        message(FATAL_ERROR "Migration '${file}' should be number ${expected}: migrations are numbered 001, 002, ... without gaps")
    endif()
    math(EXPR expected "${expected} + 1")

    get_filename_component(name "${file}" NAME_WE)
    file(READ "${SCHEMA_DIR}/${file}" hex HEX)
    string(REGEX REPLACE "(..)" "0x\\1," hex "${hex}")
    string(APPEND arrays "inline constexpr char sql_${name}[] = {${hex}0x00};\n")
    string(APPEND entries "    Migration{${version}, \"${name}\", {sql_${name}, sizeof(sql_${name}) - 1}},\n")
endforeach()

if(NOT files)
    message(FATAL_ERROR "No migrations found in ${SCHEMA_DIR}")
endif()

set(content "// Generated by cmake/EmbedMigrations.cmake from core/schema/*.sql. Do not edit
#pragma once

#include <array>
#include <string_view>

namespace core::schema {

struct Migration
{
    int version;
    std::string_view name;
    std::string_view sql;
};

${arrays}
inline constexpr std::array migrations{
${entries}};

}
")

file(WRITE "${OUTPUT}" "${content}")
